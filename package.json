{
  "name": "english-coach",
  "version": "0.1.0",
  "description": "Local-first AI writing practice desktop app.",
  "author": "lihaoze123",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": ".vite/build/index.cjs",
  "scripts": {
    "dev": "electron-forge start -- --remote-debugging-port=9222",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx scripts/review-provider-e2e.ts",
    "review:harness": "tsx scripts/review-contract-harness.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm review:harness",
    "build": "electron-forge package",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "postinstall": "electron-rebuild"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.72",
    "@ai-sdk/openai": "^3.0.54",
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron-forge/shared-types": "^7.10.2",
    "@electron/rebuild": "^4.0.1",
    "@reforged/maker-appimage": "^5.2.0",
    "@tanstack/react-query": "^5.100.6",
    "ai": "^6.0.170",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.7",
    "electron-store": "^10.1.0",
    "keytar": "^7.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitejs/plugin-react": "^5.1.1",
    "daisyui": "^5.5.19",
    "electron": "^39.2.7",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.13"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.23.0"
}
